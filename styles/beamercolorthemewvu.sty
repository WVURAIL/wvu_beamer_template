% These hooks run after the parent theme's theorem-specific color choices.
\newcommand{\wvu@mathcolors}[2]{%
  \setbeamercolor{block title}{bg=#1,fg=#2}%
  \setbeamercolor{block body}{bg=wvu-not-quite-white,fg=wvu-coal}%
}
\AtBeginEnvironment{theorem}{\wvu@mathcolors{wvu-theorem}{wvu-not-quite-white}}
\AtBeginEnvironment{definition}{\wvu@mathcolors{wvu-definition}{wvu-coal}}
\AtBeginEnvironment{definitions}{\wvu@mathcolors{wvu-definition}{wvu-coal}}
\AtBeginEnvironment{corollary}{\wvu@mathcolors{wvu-corollary}{wvu-coal}}
\AtBeginEnvironment{lemma}{\wvu@mathcolors{wvu-lemma}{wvu-coal}}
\AtBeginEnvironment{fact}{\wvu@mathcolors{wvu-fact}{wvu-coal}}
\AtBeginEnvironment{problem}{\wvu@mathcolors{wvu-problem}{wvu-not-quite-white}}
\AtBeginEnvironment{solution}{%
  \wvu@mathcolors{wvu-solution}{wvu-coal}%
  \setbeamercolor{block body}{bg=wvu-coal,fg=wvu-not-quite-white}%
}
\AtBeginEnvironment{proof}{\wvu@mathcolors{wvu-proof}{wvu-coal}}
% Beamer's legacy German names are separate environments, not aliases.
\AtBeginEnvironment{Satz}{\wvu@mathcolors{wvu-theorem}{wvu-not-quite-white}}
\AtBeginEnvironment{Folgerung}{\wvu@mathcolors{wvu-corollary}{wvu-coal}}
\AtBeginEnvironment{Fakt}{\wvu@mathcolors{wvu-fact}{wvu-coal}}
\AtBeginEnvironment{Loesung}{%
  \wvu@mathcolors{wvu-solution}{wvu-coal}%
  \setbeamercolor{block body}{bg=wvu-coal,fg=wvu-not-quite-white}%
}

% Explicit tcolorbox colors also cover a plain tcolorbox added to a talk.
\tcbset{colback=wvu-not-quite-white,coltext=wvu-coal,colframe=wvu-coopers-gray,
  colbacktitle=wvu-coopers-gray,coltitle=wvu-coal}

\RenewDocumentEnvironment{abstract}{}{%
  \begin{tcolorbox}[boxrule=0pt,frame hidden,sharp corners,enhanced,
    colback=wvu-not-quite-white,coltext=wvu-coal,
    borderline north={2pt}{0pt}{wvu-abstract},
    borderline south={2pt}{0pt}{wvu-abstract}]
    \begin{center}\bfseries\abstractname\end{center}\itshape
}{\end{tcolorbox}}

\RenewDocumentEnvironment{quotation}{o}{%
  \begin{tcolorbox}[boxrule=0pt,frame hidden,sharp corners,enhanced,
    colback=wvu-not-quite-white,coltext=wvu-coal,
    top=1mm,bottom=1mm,
    borderline west={4pt}{0pt}{wvu-quotation}]\itshape
}{%
  \IfNoValueF{#1}{\begin{flushright}\normalfont #1\end{flushright}}%
  \end{tcolorbox}%
}

\RenewDocumentEnvironment{information}{o}{%
  \begin{tcolorbox}[leftrule=1mm,rightrule=0mm,toprule=0mm,bottomrule=0mm,
    colframe=Amurmaple@info,colback=wvu-not-quite-white,coltext=wvu-coal,
    sharp corners,detach title,coltitle=wvu-coal,
    before title={\amurmaple@info~},fonttitle=\bfseries\sffamily,
    before upper={\tcbtitle\par\medskip},
    title={\IfNoValueTF{#1}{\translate{Information}}{#1}}]
}{\end{tcolorbox}}

\RenewDocumentEnvironment{remark}{o}{%
  \smallskip
  \begin{tcolorbox}[arc=0pt,outer arc=0pt,
    colback=wvu-not-quite-white,coltext=wvu-coal,colframe=AmurmapleRemarkColor,
    colbacktitle=AmurmapleRemarkColor,coltitle=wvu-coal,
    boxsep=0pt,left=10pt,right=10pt,top=8pt,bottom=10pt,
    bottomtitle=3pt,toptitle=3pt,boxrule=0pt,fonttitle=\bfseries,
    title={\translate{Remark}\IfNoValueF{#1}{ (#1)}}]
}{\end{tcolorbox}\medskip}

\setbeamertemplate{button}{\tikz
  \node[inner xsep=4pt,minimum height=2em,draw=wvu-blue,
    fill=wvu-safety-blue,text=wvu-not-quite-white,rounded corners=1pt,align=center]
    {\footnotesize\insertbuttontext};}

% Amurmaple embeds several literal colors in its drawing templates.
% Patch only those templates; do not redefine global black/white (QR codes,
% imported artwork, and user figures may require their original colors).
\RequirePackage{xpatch}
\newcommand{\wvu@replacecolor}[3]{%
  \expandafter\xpatchcmd\csname#1\endcsname{#2}{#3}%
    {\wvu@replacecolor{#1}{#2}{#3}}{}%
}
\ExplSyntaxOn
\char_set_catcode_space:n {32}
\AtBeginDocument{%
  % xpatch must retokenize Amurmaple's expl3 drawing commands in the same mode.
  \ExplSyntaxOn
  \char_set_catcode_space:n {32}
  \wvu@replacecolor{beamer@@tmpl@background}{color=black!40}{color=wvu-seneca-gray}%
  \wvu@replacecolor{beamer@@tmpl@navigation~symbols}{\color{black}}{\color{wvu-coal}}%
  \wvu@replacecolor{beamer@@tmpl@title~page}{\textcolor{gray}}{\textcolor{wvu-rattler-gray}}%
  \wvu@replacecolor{beamer@@tmpl@title~page}{\textcolor{black}}{\textcolor{wvu-coal}}%
  \clist_map_inline:nn {beamer@@tmpl@title~page,beamer@@tmpl@section~page,
    beamer@@tmpl@part~page,beamer@@tmpl@background,sepframe~code,
    thanksframe~code,amurmaple@gauge~code}{%
    \wvu@replacecolor{#1}{{white}}{{wvu-not-quite-white}}%
    \wvu@replacecolor{#1}{[white]}{[wvu-not-quite-white]}%
    \wvu@replacecolor{#1}{=white}{=wvu-not-quite-white}%
    \wvu@replacecolor{#1}{,white,}{,wvu-not-quite-white,}%
  }%
  \ExplSyntaxOff
}
\ExplSyntaxOff

\mode<all>
